{% extends 'base.jinja' %}

{% block title %}Interactive Fiction{% endblock %}

{% block extra_head %}
<link rel="stylesheet" href="/resources/css/interactive-fiction.css?v=5">
{% endblock %}

{% block content %}
{% include 'components/navbar.jinja' %}
{% include 'interactive_fiction/library_sidebar.jinja' %}

<section class="section filetype-main-container">
    <h1 class="title">Interactive Fiction</h1>
    {% if user.is_staff %}
    <a class="button is-link is-small" href="/if/upload/">Upload a story</a>
    {% endif %}
    {% if stories %}
    <div class="if-library-grid">
        {% for story in stories %}
        {% set status = play_statuses.get(story.pk, "not_started") %}
        <div class="card if-library-card">
            <a href="/if/{{ story.slug }}/" class="if-library-card-link">
                <div class="card-image if-library-card-image">
                    {% if story.pk in cover_story_ids %}
                    <figure class="image">
                        <img src="/if/{{ story.slug }}/cover/" alt="">
                    </figure>
                    {% else %}
                    <span class="icon is-large if-library-card-placeholder"><i class="fas fa-book fa-2x"></i></span>
                    {% endif %}
                </div>
                <div class="card-content">
                    <p class="title is-5">{{ story.title }}</p>
                </div>
                {% if status == "finished" %}
                <footer class="card-footer">
                    <span class="card-footer-item tag is-success">Finished — play again</span>
                </footer>
                {% elif status == "in_progress" %}
                <footer class="card-footer">
                    <span class="card-footer-item tag is-info">Continue</span>
                </footer>
                {% endif %}
            </a>
        </div>
        {% endfor %}
    </div>
    {% if total_pages and total_pages > 1 %}
    <p class="has-text-centered">Page {{ current_page }} of {{ total_pages }}</p>
    {% endif %}
    {% else %}
    <p>No stories available.</p>
    {% endif %}
</section>
{% endblock %}
