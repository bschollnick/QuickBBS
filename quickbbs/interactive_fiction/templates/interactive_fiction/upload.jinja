{% extends 'base.jinja' %}

{% block title %}Upload a Story{% endblock %}

{% block content %}
{% include 'components/navbar.jinja' %}

<section class="section">
    <h1 class="title">Upload a Story</h1>

    {% if errors %}
    <div class="notification is-danger">
        <ul>
            {% for error in errors %}
            <li>{{ error }}</li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}

    <form method="post" enctype="multipart/form-data">
        {% csrf_token %}
        <div class="field">
            <label class="label">Title</label>
            <div class="control">
                <input class="input" type="text" name="title" required>
            </div>
        </div>
        <div class="field">
            <label class="label">Compiled story (.ink.json)</label>
            <div class="control">
                <input type="file" name="story_file" accept="application/json,.json" required>
            </div>
            <p class="help">
                Compile your .ink source with Inky (File &rarr; Export &rarr; JSON) or
                <code>inklecate story.ink</code> and upload the resulting .ink.json here.
                Any EXTERNAL function must have a same-named ink fallback (<code>=== function name(...) ===</code>)
                defined in the story — QuickBBS always runs the fallback, never a bound host function.
            </p>
        </div>
        <div class="field">
            <label class="label">Cover image (optional)</label>
            <div class="control">
                <input class="input" type="text" name="cover_gallery_path" placeholder="Full gallery path to an existing image file">
            </div>
            <p class="help">
                The full path (as shown in the gallery) of an image already in your Albums
                tree — this app doesn't accept new uploads directly, only references to files
                already synced in by the normal gallery scan. Shown on the library page. The
                file's own basename becomes its tag name.
            </p>
        </div>
        <div class="field">
            <div class="control">
                <button type="submit" class="button is-link">Upload</button>
            </div>
        </div>
    </form>
</section>
{% endblock %}
