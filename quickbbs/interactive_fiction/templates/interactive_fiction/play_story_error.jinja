<!-- The story stopped with an Ink runtime error during this turn (a defect in
     the story, such as a scene that runs out of content). Nothing was saved. -->
<div id="if-play-content">
    <div class="notification is-danger">
        <p>The story stopped with an error: {{ reason }}</p>
        <p>Your game has not been changed.</p>
        <a class="button" href="/if/{{ story.slug }}/">Back to the story</a>
    </div>
</div>
