{% extends 'base.jinja' %}

{% block title %}{{ story.title }} — Edit{% endblock %}

{% block content %}
{% include 'components/navbar.jinja' %}

<section class="section">
    <h1 class="title">Edit "{{ story.title }}"</h1>
    <a class="button is-small" href="/if/{{ story.slug }}/">Back to story</a>

    {% if errors %}
    <div class="notification is-danger">
        <ul>
            {% for error in errors %}
            <li>{{ error }}</li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}

    <form method="post" enctype="multipart/form-data">
        {% csrf_token %}
        <div class="field">
            <label class="label">Title</label>
            <div class="control">
                <input class="input" type="text" name="title" value="{{ story.title }}">
            </div>
        </div>
        <div class="field">
            <label class="control">
                <input type="checkbox" name="is_public" {% if story.is_public %}checked{% endif %}>
                Public (visible to everyone, not just people you've granted access to)
            </label>
        </div>
        <div class="field">
            <label class="label">Replace compiled story (optional)</label>
            <div class="control">
                <input type="file" name="story_file" accept="application/json,.json">
            </div>
            <p class="help">
                Leave empty to keep the current content. Uploading a revised .ink.json
                replaces the story's content for every player — a player whose saved
                progress no longer matches a renamed or removed section of the story
                may see broken or unexpected behavior until they start a new game.
            </p>
        </div>
        <div class="field">
            <label class="label">Cover image (optional)</label>
            <div class="control">
                <input class="input" type="text" name="cover_gallery_path" placeholder="Full gallery path to an existing image file">
            </div>
            <p class="help">
                The full path (as shown in the gallery) of an image already in your Albums
                tree — this app doesn't accept new uploads directly, only references to files
                already synced in by the normal gallery scan. Shown on the library page. The
                file's own basename becomes its tag name.
                {% if story.cover_image %}Current cover tag: <code>{{ story.cover_image.tag_name }}</code>.{% endif %}
            </p>
        </div>
        <div class="field">
            <div class="control">
                <button type="submit" class="button is-link">Save changes</button>
            </div>
        </div>
    </form>
</section>
{% endblock %}
