<!-- The stored save is from a newer save format than this server reads,
     so it is refused rather than loaded as defaulted fields. -->
<div id="if-play-content">
    <div class="notification is-warning">
        <p>This saved game cannot be opened: {{ reason }}</p>
        <p>Your save has not been changed. Starting a new game will replace it.</p>
        <a class="button" href="/if/{{ story.slug }}/saves/">Back to saves</a>
    </div>
</div>
