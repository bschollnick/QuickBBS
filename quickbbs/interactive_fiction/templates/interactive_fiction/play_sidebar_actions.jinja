<!-- Undo/Quicksave/Quickload/Restart sidebar actions — re-rendered via
     hx-swap-oob from play_content.jinja on every turn so
     can_undo/has_quicksave stay in sync with the story state without a
     full sidebar re-render. -->
{% if can_undo %}
<button type="button" class="button is-ghost is-fullwidth" title="Undo" hx-post="/if/{{ story.slug }}/undo/" hx-target="#if-play-content" hx-swap="outerHTML" hx-headers='{"X-CSRFToken": "{{ csrf_token }}"}'>
  {{ icon("undo fa-2x") }}
  <span class="if-sidebar-label">Undo</span>
</button>
{% endif %}
<button type="button" class="button is-ghost is-fullwidth" title="Quicksave" hx-post="/if/{{ story.slug }}/saves/quicksave/" hx-target="#if-play-content" hx-swap="outerHTML" hx-headers='{"X-CSRFToken": "{{ csrf_token }}"}'>
  {{ icon("bolt fa-2x") }}
  <span class="if-sidebar-label">Quicksave</span>
</button>
{% if has_quicksave %}
<button type="button" class="button is-ghost is-fullwidth" title="Quickload" hx-post="/if/{{ story.slug }}/saves/quickload/" hx-target="#if-play-content" hx-swap="outerHTML" hx-headers='{"X-CSRFToken": "{{ csrf_token }}"}' hx-confirm="Load the quicksave? Your current progress in this playthrough will be lost.">
  {{ icon("clock-rotate-left fa-2x") }}
  <span class="if-sidebar-label">Quickload</span>
</button>
{% endif %}
<button type="button" class="button is-ghost is-fullwidth" title="Restart" hx-post="/if/{{ story.slug }}/restart/" hx-target="#if-play-content" hx-swap="outerHTML" hx-headers='{"X-CSRFToken": "{{ csrf_token }}"}' hx-confirm="Restart this story? Your current progress in this playthrough will be lost.">
  {{ icon("redo fa-2x") }}
  <span class="if-sidebar-label">Restart</span>
</button>
