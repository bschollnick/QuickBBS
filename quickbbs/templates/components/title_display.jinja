{% from 'macros/favorite.jinja' import show_favorite_star %}
<div class="has-text-centered title-centered">
    <span class="is-size-5 has-text-weight-bold title-text" id="title" style="display: block; max-width: 50ch; margin: 0 auto; overflow-wrap: break-word; word-break: break-word;">
           {{ filename }}
    </span>
    {% if sha %}
    {{ show_favorite_star(sha, False, is_favorited, user.is_authenticated, csrf_token) }}
    {% endif %}
</div>