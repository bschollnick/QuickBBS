<nav class="navbar is-light" role="navigation" aria-label="main navigation">
  <div class="navbar-brand">
    <a class="navbar-item" href="{{ url('home') }}">
      <img src="{{ site_header_image_settings[0] }}" width="{{ site_header_image_settings[1] }}" height="{{ site_header_image_settings[2] }}" alt="Logo">
    </a>

    <!-- Mobile hamburger menu -->
    <a role="button" class="navbar-burger" aria-label="menu" aria-expanded="false" data-target="navbarBasicExample">
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </a>
  </div>

  <div id="navbarBasicExample" class="navbar-menu">
    <div class="navbar-start">
      <a class="navbar-item" href="{{ url('gallery_home') }}">
        Gallery
      </a>
      <a class="navbar-item" href="{{ url('favorites') }}"
         hx-get="{{ url('favorites') }}"
         hx-target="body"
         hx-swap="innerHTML show:window:top transition:true"
         hx-push-url="true">
        Favorites
      </a>
      <a class="navbar-item" href="{{ url('if_library') }}">
        IF
      </a>
    </div>

    <!-- Search centered -->
    <div class="navbar-center">
      <form method="post" action="{{ url('search_viewresults') }}"
            autocomplete="off">
        {% csrf_token %}
        <div class="field has-addons">
          <div class="control">
            <input id="searchtext" name="searchtext" class="input" type="text"
                   placeholder="Search titles..." value="{{ request.POST.searchtext or request.GET.searchtext or searchtext or '' }}"
                   autocomplete="off">
          </div>
          <div class="control">
            <button type="submit" class="button is-link">
              <span class="icon">
                <i class="fas fa-search"></i>
              </span>
              <span>Search</span>
            </button>
          </div>
        </div>
      </form>
    </div>

    <div class="navbar-end">
      <!-- User dropdown -->
      {% include 'components/user_menu.jinja' %}
    </div>
  </div>
</nav>

{# Burger toggle behavior lives in resources/javascript/quickbbs-optimized.js,
   delegated on document — inline scripts here would not survive HTMX innerHTML swaps. #}
