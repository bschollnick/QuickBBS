{#
  Breadcrumb Navigation Macros for QuickBBS

  This file provides reusable macros for breadcrumb navigation with smart truncation
  for long paths.

  Usage:
      {% from 'macros/breadcrumb.jinja' import show_breadcrumb_nav %}
#}

{% from 'macros/favorite.jinja' import show_favorite_star %}

{#
  Breadcrumb Navigation Macro

  Creates a breadcrumb navigation with smart truncation for long paths.
  - Shows all breadcrumbs if 4 or fewer
  - Shows first + last 3 with "..." in middle if more than 4

  Args:
      breadcrumbs (list): List of breadcrumb objects with .url and .name attributes
      current_name (str): Name of the current page (shown as active)
      max_visible (int): Maximum breadcrumbs before truncation (default: 4)
      dir_sha256 (str): dir_fqpn_sha256 of the current directory, for the
          favorite star next to the title. None (default) renders no star —
          used by contexts with no single current directory (search results),
          and by the item view, which shows its own star on the item title
          instead (title_display.jinja) rather than duplicating it here.
      is_favorited (bool): Current directory's favorite state
      user_authenticated (bool): Whether the requesting user is logged in
      csrf_token: Request's CSRF token, forwarded to the favorite star control

  Usage:
      show_breadcrumb_nav(breadcrumbs, gallery_name)

      With the favorite star (gallery listing only):
      show_breadcrumb_nav(breadcrumbs, gallery_name, dir_sha256=gallery_dir_sha256,
                           is_favorited=gallery_is_favorited, user_authenticated=user.is_authenticated,
                           csrf_token=csrf_token)

  Output:
      <nav class="breadcrumb">
          <ul>
              <li><a href="...">Home</a></li>
              <li><a href="...">Photos</a></li>
              <li class="is-active"><b>2024</b></li>
          </ul>
      </nav>
#}
{% macro show_breadcrumb_nav(breadcrumbs, current_name, max_visible=4, dir_sha256=None, is_favorited=False, user_authenticated=False, csrf_token=None) %}
<nav hx-boost="true" class="breadcrumb is-small breadcrumb-compact" aria-label="breadcrumbs">
    <ul>
        {% if breadcrumbs|length > max_visible %}
            {# First breadcrumb #}
            {{ show_breadcrumb_item(breadcrumbs[0]) }}

            {# Single ellipsis for all collapsed breadcrumbs #}
            <li><span>...</span></li>

            {# Last 3 breadcrumbs #}
            {% for breadcrumb in breadcrumbs[-3:] %}
                {{ show_breadcrumb_item(breadcrumb) }}
            {% endfor %}
        {% else %}
            {# Show all breadcrumbs normally if max_visible or fewer #}
            {% for breadcrumb in breadcrumbs %}
                {{ show_breadcrumb_item(breadcrumb) }}
            {% endfor %}
        {% endif %}
    </ul>
</nav>

{# Current page title - its own paragraph below the breadcrumb trail. #}
{% if current_name %}
<p class="gallery-title" title="{{ current_name }}">
    {% if dir_sha256 %}
    {{ show_favorite_star(dir_sha256, True, is_favorited, user_authenticated, csrf_token) }}
    {% endif %}
    <b>{{ current_name }}</b>
</p>
{% endif %}
{% endmacro %}

{#
  Breadcrumb Item Macro

  Creates a single breadcrumb list item with HTMX navigation.

  Args:
      breadcrumb: Object with .url and .name attributes
      text (str): Optional override text (used for "..." collapsed items)

  Usage:
      show_breadcrumb_item(breadcrumb)
      show_breadcrumb_item(breadcrumb, text='...')

  Output:
      <li><a href="..." hx-get="...">Breadcrumb Name</a></li>
#}
{% macro show_breadcrumb_item(breadcrumb, text=None) %}
<li>
    <a href="{{ breadcrumb.url }}"
       hx-get="{{ breadcrumb.url }}"
       hx-push-url="true"
       hx-target="body"
       hx-swap="outerHTML transition:true"
       hx-headers='{"Cache-Control": "max-age=300"}'>
        {{ text or breadcrumb.name }}
    </a>
</li>
{% endmacro %}
